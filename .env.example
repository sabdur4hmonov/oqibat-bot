BOT_TOKEN=123456789:replace_with_your_botfather_token
BOT_USERNAME=OqibatBot
DATABASE_URL=sqlite+aiosqlite:///./oqibat.db
INSTAGRAM_HANDLE=your_instagram
LOG_LEVEL=INFO
OWNER_ID=123456789
ENVIRONMENT=development
DB_POOL_SIZE=15
USE_WEBHOOK=false
WEBHOOK_URL=https://your-domain.example/telegram
WEBHOOK_SECRET=replace_with_a_random_secret
WEBHOOK_HOST=127.0.0.1
WEBHOOK_PORT=8080
RESULT_CARDS_ENABLED=true
# Docker Compose database (use a random URL-safe password; do not use this placeholder).
POSTGRES_DB=oqibat
POSTGRES_USER=oqibat
POSTGRES_PASSWORD=replace_with_a_random_hex_password
